{
  "name": "handofflog-figma-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Handofflog — snapshot-based change tracking for Figma handoffs. Phase 01 technical prototype.",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
